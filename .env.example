# Google / Gemini provider configuration (server-side only)
GOOGLE_CLOUD_PROJECT=seu-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Gateway access control
# Never ship this value in a public Android APK.
GATEWAY_API_KEY=change-me
GATEWAY_RATE_LIMIT=60
AI_TIMEOUT_MS=30000
ENVIRONMENT=production
